# Optional API Keys for LLM & ASR Services
# The application will automatically work in Offline / Demo mode if no key is provided.

# Google Gemini API Key (Recommended for LLM Summarization & Native Audio ASR)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Groq API Key (Optional alternative for ultra-fast Whisper ASR & Llama-3)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# Application Settings
DATABASE_URL=sqlite:///./meetings.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
ASR_PROVIDER=auto  # Options: auto, gemini, groq, offline
LLM_PROVIDER=auto  # Options: auto, gemini, groq, offline
